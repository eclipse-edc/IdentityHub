[{"categories":[""],"extensionPoints":[],"extensions":[{"categories":[""],"className":"org.eclipse.edc.identityhub.protocols.dcp.issuer.DcpIssuerCoreExtension","configuration":[{"defaultValue":"1000","deprecated":false,"description":"The iteration wait time in milliseconds in the state machine.","key":"edc.issuer.issuance.state-machine.iteration-wait-millis","required":true,"type":"string"},{"defaultValue":"10","deprecated":false,"description":"The number of entities to be processed on every iteration. They are leased together, so the lease must outlast the processing of all of them.","key":"edc.issuer.issuance.state-machine.batch-size","required":true,"type":"string"},{"defaultValue":"300000","deprecated":false,"description":"How long the entities of a batch are leased, in milliseconds. It must be longer than the processing of a whole batch, i.e. longer than the batch size times the call timeout, otherwise another runtime may process the same entities.","key":"edc.issuer.issuance.state-machine.lease-duration-millis","required":true,"type":"string"},{"defaultValue":"80","deprecated":false,"description":"How many times a failed operation is retried before it fails with an error. With the default delays, the retries take about six hours.","key":"edc.issuer.issuance.send.retry.limit","required":true,"type":"string"},{"defaultValue":"1000","deprecated":false,"description":"The base delay of retries in milliseconds. The n-th retry waits the base delay times 2 to the power of n, but at most the maximum delay.","key":"edc.issuer.issuance.send.retry.base-delay.ms","required":true,"type":"string"},{"defaultValue":"300000","deprecated":false,"description":"The maximum delay between two retries in milliseconds.","key":"edc.issuer.issuance.send.retry.max-delay.ms","required":true,"type":"string"},{"defaultValue":"5000","deprecated":false,"description":"How long it may take to connect to the counterparty when a message is sent, in milliseconds.","key":"edc.issuer.issuance.send.c